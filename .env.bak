# ---- Server ----
PORT=3100

# ---- WhatsApp (from the NEW "SleepUp Dialer" Meta app) ----
# System user token with whatsapp_business_messaging + whatsapp_business_management
WA_TOKEN=
PHONE_NUMBER_ID=1117138681482647
# App Dashboard > App settings > Basic > App secret (used to verify webhooks)
APP_SECRET=
# Any random string. Paste the same one in Meta webhook setup.
VERIFY_TOKEN=change-me-random-string
GRAPH_VERSION=v23.0

# ---- Telecaller logins: name:PIN, comma separated ----
AGENTS=agent1:4821,agent2:7390
# Long random string. Keeps telecallers signed in across restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Permission request ----
DEFAULT_COUNTRY_CODE=91
PERMISSION_TEXT=Vanakkam! SleepUp Mattress team ungalukku WhatsApp la call panni details solla virumbudhu. Call panna "Allow" click pannunga.
# Optional: approved call-permission template, for when the 24h chat window is closed
PERMISSION_TEMPLATE_NAME=
PERMISSION_TEMPLATE_LANG=en

# ---- Incoming calls: ring telecallers this many seconds, then reject ----
INCOMING_RING_SECONDS=25

# ---- Optional: every finished call is POSTed here (Make > Custom webhook > TeleCRM) ----
MAKE_WEBHOOK_URL=

WA_TOKEN=
